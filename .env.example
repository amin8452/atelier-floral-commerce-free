NODE_ENV=development
PORT=4000
POSTGRES_PASSWORD=change-this-for-docker
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier?schema=public
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=atelier_admin_session
ADMIN_BOOTSTRAP_TOKEN=
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

STORE_NAME=Atelier Floral
STORE_DEFAULT_CURRENCY=TND
STORE_DEFAULT_LOCALE=fr-TN
STORE_SHIPPING_FLAT_RATE=0
STORE_TAX_RATE=0
CONSENT_POLICY_VERSION=2026-01
CART_TTL_DAYS=30
LOW_STOCK_THRESHOLD=5

# Zero-cost storage: local disk, no S3/Cloudinary/R2 account required.
STORAGE_DRIVER=local
UPLOAD_DIR=data/uploads
UPLOAD_PUBLIC_PATH=/uploads
MAX_UPLOAD_BYTES=5242880

# Optional S3-compatible storage (AWS S3, Cloudflare R2 or local MinIO).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Email is optional in zero-cost mode. Use an existing SMTP account if desired.
EMAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SELLER_NOTIFICATION_EMAIL=

# Zero-cost default: cash on delivery. Online gateways are optional extensions.
PAYMENT_MODE=cash_on_delivery

WHATSAPP_NUMBER=
