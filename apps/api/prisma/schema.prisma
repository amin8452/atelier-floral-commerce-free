generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ORDER_MANAGER
  PRODUCT_MANAGER
  SUPPORT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  LOST
}

enum LeadSource {
  PRODUCT_FORM
  CONTACT_PAGE
  WHATSAPP
  OTHER
}

enum PreferredContactMethod {
  WHATSAPP
  PHONE
  EMAIL
}

enum LeadActivityType {
  LEAD_CREATED
  EMAIL_SENT
  WHATSAPP_OPENED
  CONTACTED
  STATUS_CHANGED
  NOTE_ADDED
  CONVERTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum FulfillmentStatus {
  NEW
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE
}

enum PaymentProviderType {
  CASH_ON_DELIVERY
  OTHER
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  ADD_TO_CART
  BEGIN_CHECKOUT
  LEAD_CREATED
  WHATSAPP_CLICK
  PURCHASE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AdminAuditAction {
  ADMIN_BOOTSTRAPPED
  ADMIN_CREATED
  ADMIN_UPDATED
  LOGIN_FAILED
  LOGIN_SUCCEEDED
  LOGOUT
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_ARCHIVED
  PRODUCT_DELETION_SCHEDULED
  PRODUCT_DELETION_CANCELLED
  PRODUCT_DELETED
  PRODUCT_DUPLICATED
  LEAD_STATUS_CHANGED
  LEAD_NOTE_ADDED
  ORDER_STATUS_CHANGED
  SETTINGS_UPDATED
  MEDIA_UPLOADED
  MEDIA_DELETED
  STOCK_ADJUSTED
}

model AdminUser {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique @db.VarChar(254)
  passwordHash    String
  firstName       String?         @db.VarChar(80)
  lastName        String?         @db.VarChar(80)
  role            UserRole        @default(ADMIN)
  isActive        Boolean         @default(true)
  sessions        AdminSession[]
  leads           Lead[]          @relation("LeadAssignee")
  leadActivities  LeadActivity[]
  orderActivities OrderActivity[]
  media           MediaAsset[]
  audits          AdminAudit[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([role, isActive])
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  ipAddress   String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(500)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([adminUserId, expiresAt])
  @@index([expiresAt])
}

model AdminAudit {
  id           String           @id @default(uuid()) @db.Uuid
  actorId      String?          @db.Uuid
  actor        AdminUser?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       AdminAuditAction
  resourceType String           @db.VarChar(80)
  resourceId   String?          @db.VarChar(100)
  metadata     Json?
  ipAddress    String?          @db.VarChar(64)
  createdAt    DateTime         @default(now())

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  email     String?   @db.VarChar(254)
  phone     String    @db.VarChar(40)
  firstName String    @db.VarChar(80)
  lastName  String    @db.VarChar(80)
  addresses Address[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model Address {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName  String    @db.VarChar(80)
  lastName   String    @db.VarChar(80)
  phone      String    @db.VarChar(40)
  line1      String    @db.VarChar(220)
  line2      String?   @db.VarChar(220)
  city       String    @db.VarChar(120)
  postalCode String?   @db.VarChar(30)
  country    String    @db.VarChar(2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(160)
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, name])
}

model Collection {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @db.VarChar(120)
  slug        String              @unique @db.VarChar(160)
  description String?
  isActive    Boolean             @default(true)
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([isActive, name])
}

model Product {
  id                    String              @id @default(uuid()) @db.Uuid
  categoryId            String?             @db.Uuid
  category              Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug                  String              @unique @db.VarChar(180)
  name                  String              @db.VarChar(180)
  shortDescription      String?             @db.VarChar(400)
  description           String?
  sku                   String?             @unique @db.VarChar(100)
  basePrice             Decimal             @db.Decimal(12, 3)
  salePrice             Decimal?            @db.Decimal(12, 3)
  stock                 Int                 @default(0)
  status                ProductStatus       @default(DRAFT)
  tags                  String[]            @default([])
  personalizationSchema Json?
  metaTitle             String?             @db.VarChar(180)
  metaDescription       String?             @db.VarChar(320)
  publishedAt           DateTime?
  deletionRequestedAt   DateTime?
  deletionScheduledFor  DateTime?
  deletionRequestedById String?             @db.Uuid
  images                ProductImage[]
  variants              ProductVariant[]
  collections           ProductCollection[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  leads                 Lead[]
  analytics             AnalyticsEvent[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([deletionScheduledFor])
  @@index([createdAt])
}

model ProductCollection {
  productId    String     @db.Uuid
  collectionId String     @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([productId, collectionId])
  @@index([collectionId, sortOrder])
}

model ProductVariant {
  id          String         @id @default(uuid()) @db.Uuid
  productId   String         @db.Uuid
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String         @unique @db.VarChar(100)
  name        String         @db.VarChar(180)
  options     Json
  price       Decimal?       @db.Decimal(12, 3)
  salePrice   Decimal?       @db.Decimal(12, 3)
  stock       Int            @default(0)
  isActive    Boolean        @default(true)
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  leads       Lead[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([id, productId])
  @@index([productId, isActive])
}

model MediaAsset {
  id           String         @id @default(uuid()) @db.Uuid
  storageKey   String         @unique @db.VarChar(500)
  url          String
  mimeType     String         @db.VarChar(100)
  extension    String         @db.VarChar(12)
  size         Int
  altText      String         @db.VarChar(260)
  uploadedById String?        @db.Uuid
  uploadedBy   AdminUser?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productImages ProductImage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([createdAt])
  @@index([uploadedById])
}

model ProductImage {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @db.Uuid
  variantId String?         @db.Uuid
  assetId   String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)
  asset     MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  altText   String          @db.VarChar(260)
  sortOrder Int             @default(0)
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([productId, assetId])
  @@index([productId, sortOrder])
  @@index([variantId, productId])
  @@index([assetId])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  tokenHash String     @unique @db.Char(64)
  items     CartItem[]
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([expiresAt])
}

model CartItem {
  id               String          @id @default(uuid()) @db.Uuid
  cartId           String          @db.Uuid
  productId        String          @db.Uuid
  productVariantId String?         @db.Uuid
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant? @relation(fields: [productVariantId, productId], references: [id, productId], onDelete: Restrict)
  quantity         Int
  personalization  Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([productVariantId, productId])
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  orderNumber       String            @unique @db.VarChar(50)
  idempotencyKey    String            @unique @db.VarChar(180)
  customerId        String?           @db.Uuid
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerSnapshot  Json
  shippingAddress   Json
  notes             String?
  currency          String            @db.VarChar(3)
  promotionCode     String?           @db.VarChar(80)
  subtotal          Decimal           @db.Decimal(12, 3)
  discount          Decimal           @default(0) @db.Decimal(12, 3)
  shipping          Decimal           @default(0) @db.Decimal(12, 3)
  tax               Decimal           @default(0) @db.Decimal(12, 3)
  total             Decimal           @db.Decimal(12, 3)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(NEW)
  items             OrderItem[]
  payments          Payment[]
  activities        OrderActivity[]
  analytics         AnalyticsEvent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @db.Uuid
  productId           String?         @db.Uuid
  productVariantId    String?         @db.Uuid
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant      ProductVariant? @relation(fields: [productVariantId, productId], references: [id, productId], onDelete: Restrict)
  productNameSnapshot String          @db.VarChar(180)
  skuSnapshot         String?         @db.VarChar(100)
  variantSnapshot     Json?
  unitPrice           Decimal         @db.Decimal(12, 3)
  quantity            Int
  personalization     Json?
  total               Decimal         @db.Decimal(12, 3)
  createdAt           DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId, productId])
}

model OrderActivity {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @db.Uuid
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentStatus     PaymentStatus?
  fulfillmentStatus FulfillmentStatus?
  note              String?
  createdById       String?            @db.Uuid
  createdBy         AdminUser?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())

  @@index([orderId, createdAt])
  @@index([createdById])
}

model Payment {
  id             String              @id @default(uuid()) @db.Uuid
  orderId        String              @db.Uuid
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       PaymentProviderType
  method         PaymentMethod
  status         PaymentStatus       @default(PENDING)
  amount         Decimal             @db.Decimal(12, 3)
  currency       String              @db.VarChar(3)
  providerRef    String?             @db.VarChar(180)
  idempotencyKey String?             @unique @db.VarChar(180)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([orderId, status])
  @@index([providerRef])
}

model Lead {
  id                     String                 @id @default(uuid()) @db.Uuid
  firstName              String                 @db.VarChar(80)
  lastName               String                 @db.VarChar(80)
  phone                  String                 @db.VarChar(40)
  email                  String?                @db.VarChar(254)
  subject                String?                @db.VarChar(180)
  message                String?
  preferredContactMethod PreferredContactMethod
  consentToContact       Boolean
  consentAt              DateTime
  consentPolicyVersion   String                 @db.VarChar(40)
  productId              String?                @db.Uuid
  productVariantId       String?                @db.Uuid
  quantity               Int                    @default(1)
  source                 LeadSource
  status                 LeadStatus             @default(NEW)
  assignedToId           String?                @db.Uuid
  assignedTo             AdminUser?             @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  product                Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant         ProductVariant?        @relation(fields: [productVariantId, productId], references: [id, productId], onDelete: Restrict)
  activities             LeadActivity[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([email])
  @@index([productId])
  @@index([productVariantId, productId])
  @@index([assignedToId])
}

model LeadActivity {
  id          String           @id @default(uuid()) @db.Uuid
  leadId      String           @db.Uuid
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  metadata    Json?
  createdById String?          @db.Uuid
  createdBy   AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([createdById])
}

model Promotion {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @db.VarChar(160)
  code          String       @unique @db.VarChar(80)
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 3)
  minimumAmount Decimal?     @db.Decimal(12, 3)
  usageLimit    Int?
  usageCount    Int          @default(0)
  isActive      Boolean      @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  rules         Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model AnalyticsEvent {
  id        String             @id @default(uuid()) @db.Uuid
  type      AnalyticsEventType
  productId String?            @db.Uuid
  orderId   String?            @db.Uuid
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sessionId String?            @db.VarChar(128)
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([productId, type, createdAt])
  @@index([orderId])
}

model StoreSettings {
  id                   String   @id @default("store") @db.VarChar(20)
  storeName            String   @db.VarChar(160)
  storeEmail           String?  @db.VarChar(254)
  supportEmail         String?  @db.VarChar(254)
  whatsappNumber       String?  @db.VarChar(40)
  defaultCurrency      String   @db.VarChar(3)
  defaultLocale        String   @db.VarChar(20)
  address              String?
  city                 String?  @db.VarChar(120)
  country              String?  @db.VarChar(2)
  shippingEnabled      Boolean  @default(true)
  shippingFlatRate     Decimal  @default(0) @db.Decimal(12, 3)
  taxRate              Decimal  @default(0) @db.Decimal(7, 4)
  codEnabled           Boolean  @default(true)
  onlinePaymentEnabled Boolean  @default(false)
  instagramUrl         String?
  facebookUrl          String?
  heroImageUrl         String?
  storyImageUrl        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
